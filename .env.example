# Supabase → Project Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" (legacy) or "publishable" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# The "service_role" (legacy) or "secret" key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Any long random string. Vercel Cron sends it to /api/cleanup.
CRON_SECRET=generate-a-long-random-string

# Push notifications (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=https://your-app.vercel.app
# Shared secret the database sends to /api/push (also stored in private.config)
PUSH_WEBHOOK_SECRET=generate-a-long-random-string
